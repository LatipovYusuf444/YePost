<?xml version="1.0" encoding="utf-8"?>
<!--
  FAQAT debug APK: dasturchi kompyuteridagi sinov serveri (YEPOST_ILOVA_URL=http://localhost:4173 + `adb reverse tcp:4173 tcp:4173`)
  uchun http ruxsat. Release APK main/res/xml/network_security_config.xml dan foydalanadi — u yerda faqat HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
